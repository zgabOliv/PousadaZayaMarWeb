@model ResumoPainel
@{ ViewData["Title"] = "Painel"; var mov = (List<MovimentoItem>)ViewBag.Movimento; }
<partial name="_AdminMenu" />
<h1>Hoje, @Fmt.Data(Model.Hoje)</h1>
<div class="kpis">
  <a class="kpi" asp-action="Mapa"><strong>@Model.QuartosOcupadosHoje/@Model.TotalQuartos</strong><span>quartos ocupados</span></a>
  <div class="kpi"><strong>@Model.CheckInsPendentes</strong><span>check-in(s) a fazer</span></div>
  <div class="kpi"><strong>@Model.SaidasHoje</strong><span>saída(s) hoje</span></div>
  <div class="kpi"><strong>@Model.Hospedados</strong><span>hospedado(s) agora</span></div>
  <a class="kpi" asp-action="Reservas" asp-route-status="Pendente"><strong>@Model.ReservasPendentes</strong><span>reserva(s) aguardando pagamento</span></a>
  <a class="kpi" asp-action="Mensagens"><strong>@Model.MensagensNovas</strong><span>mensagem(ns) nova(s)</span></a>
  @if (User.IsInRole("Gerente")) { <div class="kpi"><strong>@Fmt.Brl(Model.ReceitaMes)</strong><span>recebido no mês</span></div> }
</div>
<p><a class="btn" asp-action="NovaReserva">Nova reserva</a></p>

<h2>Movimento de hoje</h2>
@if (mov.Count == 0) { <p class="muted">Nenhuma entrada ou saída prevista para hoje.</p> }
else
{
<div class="scroll"><table>
  <thead><tr><th>Tipo</th><th>Reserva</th><th>Hóspede</th><th>Quarto</th><th>Pagamento</th><th>Ação</th></tr></thead>
  <tbody>
  @foreach (var m in mov)
  {
    <tr>
      <td><span class="selo @(m.Movimento == "Entrada" ? "st-confirmada" : "st-pendente")">@(m.Movimento == "Entrada" ? "Entrada" : "Saída")</span></td>
      <td>@m.Codigo</td><td>@m.Hospede</td><td>@m.Quarto (@m.Tipo)</td>
      <td>@Fmt.Brl(m.ValorPago) de @Fmt.Brl(m.ValorTotal)</td>
      <td>
        @if (m.Movimento == "Entrada" && m.CheckInEm is null)
        {
          @if (m.ValorPago >= m.ValorTotal && m.Status == "Confirmada")
          {
            <form asp-action="CheckIn" method="post" class="inline"><input type="hidden" name="codigo" value="@m.Codigo"><button type="submit">Fazer check-in</button></form>
          }
          else
          {
            <form asp-action="Pagar" method="post" class="inline">
              <input type="hidden" name="codigo" value="@m.Codigo"><input type="hidden" name="volta" value="@Url.Action("Index")">
              <input type="hidden" name="valor" value="@((m.ValorTotal - m.ValorPago).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
              <select name="forma" aria-label="Forma de pagamento"><option>Pix</option><option>Cartao</option><option>Dinheiro</option></select>
              <button type="submit">Receber @Fmt.Brl(m.ValorTotal - m.ValorPago)</button>
            </form>
          }
        }
        else if (m.CheckInEm is not null && m.CheckOutEm is null)
        {
          <form asp-action="CheckOut" method="post" class="inline"><input type="hidden" name="codigo" value="@m.Codigo"><button type="submit">Fazer check-out</button></form>
        }
        else if (m.CheckOutEm is not null) { <span class="muted">Check-out feito</span> }
        else if (m.CheckInEm is not null) { <span class="muted">Hospedado</span> }
      </td>
    </tr>
  }
  </tbody>
</table></div>
}
