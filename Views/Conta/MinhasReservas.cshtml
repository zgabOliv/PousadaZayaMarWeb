@model List<MinhaReserva>
@{ ViewData["Title"] = "Minhas reservas"; var p = (PerfilHospede)ViewBag.Perfil; }
<h1>Minhas reservas</h1>
<p class="muted">@p.Nome, @p.Email</p>
@if (!p.EmailConfirmado)
{
  <section class="card aviso">
    <p><strong>Confirme seu e-mail</strong> para ver suas reservas. Enviamos um link para @p.Email.</p>
    <form asp-action="ReenviarConfirmacao" method="post"><button type="submit">Reenviar link</button></form>
  </section>
}
else
{
  <p><a class="btn" asp-controller="Home" asp-action="Index" asp-fragment="reservar">Nova reserva</a></p>
  @if (Model.Count == 0) { <p>Você ainda não tem reservas. Escolha as datas na <a asp-controller="Home" asp-action="Index">página inicial</a>.</p> }
  <div class="grid">
  @foreach (var r in Model)
  {
    <article class="card">
      <h3>@r.Tipo <small class="muted">@r.Codigo</small></h3>
      <p>@Fmt.Data(r.DataEntrada) a @Fmt.Data(r.DataSaida) (@r.Noites noite(s)), @r.QtdHospedes hóspede(s)</p>
      <p>Total @Fmt.Brl(r.ValorTotal). Pago @Fmt.Brl(r.ValorPago).</p>
      <p><span class="selo st-@r.Status.ToLowerInvariant()">@r.Status</span></p>
      @if (r.Cancelavel)
      {
        <form asp-action="Cancelar" method="post"><input type="hidden" name="codigo" value="@r.Codigo"><button type="submit" class="danger">Cancelar reserva</button></form>
        <p class="muted">Cancelamento gratuito até 7 dias antes da entrada.</p>
      }
      @if (r.PodeAvaliar) { <a class="btn sec" asp-action="Avaliar" asp-route-codigo="@r.Codigo">Avaliar estadia</a> }
      @if (r.Avaliada) { <p class="muted">Estadia avaliada. Obrigado!</p> }
    </article>
  }
  </div>
}
